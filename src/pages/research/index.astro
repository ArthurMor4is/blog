---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";

const papers = (await getCollection("papers"))
  .sort((a, b) => b.data.year - a.data.year);

const entries = await Promise.all(
  papers.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title="Research" description="Academic papers and research I have contributed to.">
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">Research</div>
      <ul class="flex flex-col space-y-8">
        {entries.map(entry => (
          <li class="animate space-y-1">
            <div class="font-semibold text-black dark:text-white leading-snug">
              {entry.data.url
                ? <Link href={entry.data.url} external>{entry.data.title}</Link>
                : entry.data.title
              }
            </div>
            <div class="text-sm opacity-75">{entry.data.authors}</div>
            <div class="text-sm opacity-60 italic">{entry.data.venue} · {entry.data.year}</div>
            <article class="mt-2"><entry.Content /></article>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</PageLayout>
