---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const allpapers = (await getCollection("papers")).sort(
  (a, b) => b.data.year - a.data.year
);

const papers = await Promise.all(
  allpapers.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">Hi there!</h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            I like to build things and I'm always anxious about the number of
            books I'd like to read. I work on AI systems at <Link
              href="https://getenter.ai/en"
              external>Enter</Link
            > and write about machine learning, software engineering, and ideas I
            find interesting.
            <Link href="/about">More about me.</Link>
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Latest posts</h5>
          <Link href="/blog">See all posts</Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Research</h5>
          <Link href="/research">See all</Link>
        </div>
        <ul class="flex flex-col space-y-6">
          {
            papers.map((entry) => (
              <li class="space-y-1">
                <div class="font-semibold text-black dark:text-white leading-snug">
                  {entry.data.url ? (
                    <Link href={entry.data.url} external>
                      {entry.data.title}
                    </Link>
                  ) : (
                    entry.data.title
                  )}
                </div>
                <div class="text-sm opacity-75">{entry.data.authors}</div>
                <div class="text-sm opacity-60 italic">
                  {entry.data.venue} · {entry.data.year}
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">Let's Connect</h5>
        <ul class="flex flex-wrap gap-2">
          {
            SOCIALS.map((SOCIAL) => (
              <li class="flex gap-x-2 text-nowrap">
                <Link
                  href={SOCIAL.HREF}
                  external
                  aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
                >
                  {SOCIAL.NAME}
                </Link>
                {"/"}
              </li>
            ))
          }
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
